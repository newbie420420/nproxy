<template name="Console">
    <head>
        <title>Console</title>
		<link type="text/rcss" href="../../BaseStyles.rcss" />
		<link type="text/template" href="../Base/BasePopup.rml" />
        <link type="text/rcss" href="Console.rcss" />
        <script lang="text/lua">
            ConsoleLastLogSignature = nil
            ConsoleWasVisible = false
            ConsoleForceOpenTicks = 0
            ConsoleFollowNewestTicks = 0
            ConsoleChatMouseHeld = false
            ConsoleAutoFollowNewest = true
            ConsoleProgrammaticScroll = false
            ConsoleHoldStartedFollowing = true
            ConsoleHoldStartScrollTop = 0

            function ConsoleGetWindow(document)
                return document:GetElementById('legacy_chat_window_fixed_2026')
            end

            function ConsolePinWindow(document)
                local wnd = ConsoleGetWindow(document)
                if not wnd then return end

                wnd.style.left = '48dp'
                wnd.style.top = '0dp'
                wnd.style.right = 'auto'
                wnd.style.bottom = 'auto'
                wnd.style.width = '84.8vw'
                wnd.style['min-width'] = '84.8vw'
                wnd.style['max-width'] = '84.8vw'
            end

            function ConsoleUpdateExpanded(document)
                local wnd = ConsoleGetWindow(document)
                if not wnd then return end
                wnd:SetClass('expanded', wnd.client_height >= 330)
            end

            function ConsoleLineTime(line)
                if not line then return nil end
                local rml = line.inner_rml or ''
                local h, m, sec = string.match(rml, '%[(%d%d):(%d%d):(%d%d)%]')
                if not h then return nil end
                return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec)
            end

            function ConsoleFindTimedLine(lines, from_start)
                if not lines then return nil, nil end

                local line = from_start and lines.first_child or lines.last_child
                while line do
                    local stamp = ConsoleLineTime(line)
                    if stamp ~= nil then
                        return line, stamp
                    end
                    line = from_start and line.next_sibling or line.previous_sibling
                end

                return nil, nil
            end

            function ConsoleNormalizeLogOrder(document)
                local lines = document:GetElementById('log-lines')
                if not lines then return false end

                local first_line, first_time = ConsoleFindTimedLine(lines, true)
                local last_line, last_time = ConsoleFindTimedLine(lines, false)

                if first_time ~= nil and last_time ~= nil and first_time ~= last_time then
                    local forward = (last_time - first_time + 86400) % 86400
                    local newest_first = forward > 43200
                    lines:SetClass('reverse-order', newest_first)
                    return newest_first
                end

                return lines:IsClassSet('reverse-order')
            end

            function ConsoleGetNewestLine(document)
                local lines = document:GetElementById('log-lines')
                if not lines then return nil end

                local newest_first = ConsoleNormalizeLogOrder(document)
                if newest_first then
                    return lines.first_child
                end
                return lines.last_child
            end

            function ConsoleBuildLogSignature(document)
                local lines = document:GetElementById('log-lines')
                if not lines then return '' end

                local count = #lines.child_nodes
                local first = lines.first_child
                local last = lines.last_child
                local first_rml = first and first.inner_rml or ''
                local last_rml = last and last.inner_rml or ''

                -- Including both ends catches updates even when the newest text is
                -- identical to the previous message and the visible list is full.
                return tostring(count) .. '|' .. first_rml .. '|' .. last_rml
            end

            function ConsoleElementTopInside(element, ancestor)
                if not element or not ancestor then return nil end

                local y = element.offset_top or 0
                local parent = element.offset_parent

                while parent and parent ~= ancestor do
                    y = y + (parent.offset_top or 0)
                    parent = parent.offset_parent
                end

                if parent ~= ancestor then
                    return nil
                end

                return y
            end

            function ConsoleGetNewestScrollTarget(document)
                local log = document:GetElementById('log-content')
                local newest = ConsoleGetNewestLine(document)
                if not log or not newest then return nil, nil end

                local max_scroll = log.scroll_height - log.client_height
                if 0 > max_scroll then max_scroll = 0 end

                local y = ConsoleElementTopInside(newest, log)
                if y == nil then
                    -- Safe fallback for unusual offset-parent chains.
                    local lines = document:GetElementById('log-lines')
                    if lines and lines:IsClassSet('reverse-order') then
                        return log, 0
                    end
                    return log, max_scroll
                end

                local target = y + (newest.offset_height or 0) - log.client_height
                if 0 > target then target = 0 end
                if target > max_scroll then target = max_scroll end
                return log, target
            end

            function ConsoleIsAtNewest(document)
                local log, target = ConsoleGetNewestScrollTarget(document)
                if not log or target == nil then return true end
                return math.abs((log.scroll_top or 0) - target) <= 3
            end

            function ConsoleChatScrolled(document, element)
                -- Manual scrolling controls whether new messages should auto-follow.
                -- While Mouse1 is held, defer the decision until release so incoming
                -- messages cannot accidentally turn follow mode off by changing layout.
                if ConsoleProgrammaticScroll or ConsoleChatMouseHeld then return end

                ConsoleAutoFollowNewest = ConsoleIsAtNewest(document)
                if not ConsoleAutoFollowNewest then
                    ConsoleFollowNewestTicks = 0
                end
            end

            function ConsoleScrollNewest(document)
                -- While Mouse1 is held anywhere on the chat, freeze the viewport.
                if ConsoleChatMouseHeld then return end

                local log, target = ConsoleGetNewestScrollTarget(document)
                if not log or target == nil then return end

                ConsoleProgrammaticScroll = true
                log.scroll_top = target
                ConsoleProgrammaticScroll = false
                ConsoleAutoFollowNewest = true
            end

            function ConsoleSetTypingVisible(document, visible)
                local panel = document:GetElementById('input-panel')
                if panel then
                    panel:SetClass('typing', visible)
                end

                -- The log must only reserve room for the input while typing.
                -- Mirroring the state onto the outer chat window lets RCSS
                -- collapse/restore the whole bottom row without affecting the
                -- text field's ability to receive programmatic focus.
                local wnd = ConsoleGetWindow(document)
                if wnd then
                    wnd:SetClass('typing', visible)
                end
            end

            function ConsoleTypingBegin(document)
                ConsoleSetTypingVisible(document, true)
            end

            function ConsoleTypingEnd(document)
                ConsoleSetTypingVisible(document, false)
            end

            function ConsoleForceOpenNewest(document)
                -- The input focus event is the reliable "chat just opened" signal.
                -- One immediate scroll can still happen before RmlUi finishes laying
                -- out the freshly shown log, so keep forcing newest for a handful
                -- of watchdog frames. This replaces the manual drag that previously
                -- caused the correct line to appear.
                ConsolePinWindow(document)
                ConsoleUpdateExpanded(document)
                ConsoleWasVisible = true
                ConsoleLastLogSignature = nil
                ConsoleForceOpenTicks = 10
                ConsoleFollowNewestTicks = 4
                ConsoleNormalizeLogOrder(document)
                ConsoleScrollNewest(document)
            end

            function ConsoleFollowIfChanged(document)
                -- New messages may keep arriving while Mouse1 is held. Keep the
                -- current viewport frozen and decide what to do on release.
                if ConsoleChatMouseHeld then
                    ConsoleFollowNewestTicks = 0
                    return
                end

                ConsoleNormalizeLogOrder(document)
                local signature = ConsoleBuildLogSignature(document)

                if signature ~= ConsoleLastLogSignature then
                    ConsoleLastLogSignature = signature

                    -- Only follow incoming messages when the user is already at the
                    -- newest chat line. Scrolling up switches into history-reading
                    -- mode until they manually return to the bottom.
                    if ConsoleAutoFollowNewest then
                        ConsoleFollowNewestTicks = 4
                    else
                        ConsoleFollowNewestTicks = 0
                    end
                end

                if ConsoleAutoFollowNewest and ConsoleFollowNewestTicks > 0 then
                    ConsoleScrollNewest(document)
                    ConsoleFollowNewestTicks = ConsoleFollowNewestTicks - 1
                end
            end

            function ConsoleWatchdogTick(document, element)
                -- Re-check the active document/context continuously. This is cheap
                -- because ConsoleInstallTabBlock returns immediately while they are
                -- unchanged, but repairs TAB handling after UI context recreation.
                ConsoleInstallTabBlock(document)

                -- Growtopia does not reliably emit the list callback when its own
                -- "new messages below" setting is disabled. Poll the rendered
                -- bound list instead, and only auto-follow when its content changed.
                local wnd = ConsoleGetWindow(document)
                local visible = wnd ~= nil and wnd.client_width > 0 and wnd.client_height > 0

                if not visible then
                    ConsoleWasVisible = false
                    ConsoleLastLogSignature = nil
                    ConsoleForceOpenTicks = 0
                    ConsoleFollowNewestTicks = 0
                    ConsoleAutoFollowNewest = true
                else
                    ConsolePinWindow(document)
                    ConsoleUpdateExpanded(document)

                    if ConsoleForceOpenTicks > 0 then
                        -- Keep following newest while the just-opened console settles.
                        -- 10 x 0.08s gives the bound list/layout enough time to render.
                        ConsoleNormalizeLogOrder(document)
                        ConsoleScrollNewest(document)
                        ConsoleLastLogSignature = ConsoleBuildLogSignature(document)
                        ConsoleFollowNewestTicks = 4
                        ConsoleForceOpenTicks = ConsoleForceOpenTicks - 1
                    elseif not ConsoleWasVisible then
                        ConsoleWasVisible = true
                        ConsoleNormalizeLogOrder(document)
                        ConsoleScrollNewest(document)
                        ConsoleLastLogSignature = ConsoleBuildLogSignature(document)
                        ConsoleFollowNewestTicks = 4
                    else
                        ConsoleFollowIfChanged(document)
                    end
                end

                -- RmlUi has animationend, but no animationiteration event. Alternate
                -- two one-shot animations so this becomes a lightweight UI tick.
                if element:IsClassSet('watchdog-a') then
                    element:SetClass('watchdog-a', false)
                    element:SetClass('watchdog-b', true)
                else
                    element:SetClass('watchdog-b', false)
                    element:SetClass('watchdog-a', true)
                end
            end

            function ConsoleLogUpdated(document, element)
                ConsolePinWindow(document)
                ConsoleUpdateExpanded(document)
                ConsoleFollowIfChanged(document)
            end

            function ConsoleChatHoldBegin(document, event)
                -- RmlUi button 0 = left mouse button (Mouse1).
                if not event or event.parameters.button ~= 0 then return end

                ConsoleHoldStartedFollowing = ConsoleAutoFollowNewest
                local log = document:GetElementById('log-content')
                ConsoleHoldStartScrollTop = log and (log.scroll_top or 0) or 0

                ConsoleChatMouseHeld = true
                ConsoleFollowNewestTicks = 0
            end

            function ConsoleChatHoldEnd(document, event)
                -- The context-level mouseup listener also sees releases outside
                -- the chat, so a held chat can never get stuck in frozen mode.
                if event and event.parameters.button ~= 0 then return end
                if not ConsoleChatMouseHeld then return end

                ConsoleChatMouseHeld = false
                ConsoleNormalizeLogOrder(document)

                local log = document:GetElementById('log-content')
                local current_scroll = log and (log.scroll_top or 0) or ConsoleHoldStartScrollTop
                local scroll_moved = math.abs(current_scroll - ConsoleHoldStartScrollTop) > 3

                -- Normal hold at the bottom: release catches up with messages that
                -- arrived while frozen. But if the hold started in history mode, or
                -- the user actually moved the scrollbar during the hold, preserve it.
                if scroll_moved then
                    ConsoleAutoFollowNewest = ConsoleIsAtNewest(document)
                else
                    ConsoleAutoFollowNewest = ConsoleHoldStartedFollowing
                end

                if ConsoleAutoFollowNewest then
                    ConsoleScrollNewest(document)
                    ConsoleFollowNewestTicks = 2
                else
                    ConsoleFollowNewestTicks = 0
                end

                ConsoleLastLogSignature = ConsoleBuildLogSignature(document)
            end

            function ConsoleResizeDrag(document)
                ConsolePinWindow(document)
                ConsoleUpdateExpanded(document)
                if ConsoleAutoFollowNewest then
                    ConsoleScrollNewest(document)
                    ConsoleFollowNewestTicks = 2
                else
                    ConsoleFollowNewestTicks = 0
                end
                ConsoleLastLogSignature = ConsoleBuildLogSignature(document)
            end

            function ConsoleResizeEnd(document)
                ConsolePinWindow(document)
                ConsoleUpdateExpanded(document)
                if ConsoleAutoFollowNewest then
                    ConsoleScrollNewest(document)
                    ConsoleFollowNewestTicks = 2
                else
                    ConsoleFollowNewestTicks = 0
                end
                ConsoleLastLogSignature = ConsoleBuildLogSignature(document)
            end

            -- Block RmlUi from treating TAB (Rml::Input::KI_TAB = 70) as a
            -- console/chat focus key. Track the actual document + UI context instead
            -- of using a permanent boolean: GT can recreate/swap UI state after
            -- tutorial/menu actions while Lua globals survive, which made the old
            -- listener disappear while ConsoleTabBlockInstalled stayed true.
            ConsoleTabBlockDocument = ConsoleTabBlockDocument or nil
            ConsoleTabBlockContext = ConsoleTabBlockContext or nil

            function ConsoleInstallTabBlock(document)
                if not document or not document.context then return end

                local context = document.context
                if ConsoleTabBlockDocument == document and ConsoleTabBlockContext == context then
                    return
                end

                ConsoleTabBlockDocument = document
                ConsoleTabBlockContext = context

                -- TAB should never focus/navigate the RmlUi chat. If the message
                -- input is currently active, blur it first so TAB immediately exits
                -- typing; Growtopia can still use the same physical TAB press for its
                -- normal punch/wrench mode switch outside the UI.
                local block_tab = "if event.parameters.key_identifier == 70 then local input = document:GetElementById('input-text'); if input then input:Blur() end; event:StopImmediatePropagation() end"

                -- Capture both phases. Keydown exits an active message box immediately;
                -- keyup is blocked too so RmlUi cannot move focus back into the chat.
                context:AddEventListener('keydown', block_tab, document, true)
                context:AddEventListener('keyup', block_tab, document, true)

                -- Catch Mouse1 release even when the cursor leaves the chat before
                -- the button is released.
                context:AddEventListener('mouseup', "ConsoleChatHoldEnd(document, event)", document, true)
            end
        </script>
	</head>
	<body onshow="ConsoleInstallTabBlock(document)">
		<div id="legacy_chat_window_fixed_2026" class="chat_region" data-model="ConsoleModel" data-class-hidden="!ConsoleModel.IsShown" onmousedown="ConsoleChatHoldBegin(document, event)">

			<div id="classic_chat_fill"></div>
			<div id="chat-watchdog" class="watchdog-a" onanimationend="ConsoleWatchdogTick(document, element)"></div>

			<!-- Special Characters Preview -->
			<div class="preview-panel" data-class-hidden="!ConsoleModel.InputSpecialChars">
				<div id="preview-content">
					<div id="preview-text" data-rml="ToRMLText(ConsoleModel.PreviewText)"/>
				</div>
			</div>
			

			<!-- Filter Buttons -->
			<form id="filter" name="duration" data-value="ConsoleModel.Filter" onclick="OnEvent(event, 'Console.OnFilter')">
				<input type="radio" id="filter_all" value="0" data-checked="ConsoleModel.Filter" data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label for="filter_all" class="filter_btn filter_all_clr">
					<span class="icon filter_all"></span>
					<div class="filter_name">ALL</div>
				</label>

				<input type="radio" id="filter_world" value="1" data-checked="ConsoleModel.Filter"  data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label for="filter_world" class="filter_btn filter_world_clr">
					<span class="icon filter_world"></span>
					<div class="filter_name">WORLD</div>
				</label>

				<input type="radio" id="filter_private" value="2" data-checked="ConsoleModel.Filter" />
				<label for="filter_private" class="filter_btn filter_private_clr">
					<span class="icon filter_private"></span>
					<div class="filter_name">PRIVATE</div>
				</label>

				<input type="radio" id="filter_system" value="3" data-checked="ConsoleModel.Filter" />
				<label for="filter_system" class="filter_btn filter_system_clr">
					<span class="icon filter_system"></span>
					<div class="filter_name">SYSTEM</div>
				</label>

				<input type="radio" id="filter_custom" value="4" data-checked="ConsoleModel.Filter"  data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label for="filter_custom" class="filter_btn filter_custom_clr">
					<span class="icon filter_custom"></span>
					<div class="filter_name">CUSTOM</div>
				</label>

				<div class="chat_settings" data-class-hidden="ConsoleModel.Filter != 4" onclick="OnEvent(element, 'Console.OnClickCustomSettings')">
					<div id="chat_image"/>
				</div>
			</form>

			<!-- Custom Settings Popup -->
			<div id="custom-settings-popup" class="popup hidden">
				<div style="padding: 8dp;">Select the content to be shown on the Custom tab</div>
				<form id="custom-settings" class="checkbox-group" onchange="OnEvent(event, 'Console.OnCustomSettingsChange')">
					<label class="checkbox-row">
						<input type="checkbox" class="checkbox" filter-type="Global" value="0" data-checked="ConsoleModel.GlobalMessages"/>
						<span class="label">Global Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" class="checkbox" filter-type="Global" value="1" data-checked="ConsoleModel.WorldMessages"/>
						<span class="label">World Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" class="checkbox" filter-type="Global" value="2" data-checked="ConsoleModel.PrivateMessages"/>
						<span class="label">Private Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" class="checkbox" filter-type="Global" value="3" data-checked="ConsoleModel.FriendMessages"/>
						<span class="label">Friend Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" class="checkbox" filter-type="Global" value="4" data-checked="ConsoleModel.GuildMessages"/>
						<span class="label">Guild Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" class="checkbox" filter-type="Global" value="5" data-checked="ConsoleModel.SystemMessages"/>
						<span class="label">Game/System Messages</span>
					</label>
				</form>
			</div>

			<!-- Input Panel -->
			<div id="input-panel" class="input-panel">
				<div id="input-content">
					<div class="message-hint-panel" data-class-hidden="len(ConsoleModel.InputText) > 0">
						<div id="message-hint-text">Enter Message Here</div>
					</div>
					<input id="input-text" type="text" maxlength="120" data-value="ConsoleModel.InputText"
							onkeyup="OnEvent(event, 'Console.HandleInput')"
							onblur="ConsoleTypingEnd(document); OnEvent(event, 'Console.HandleInputFocusEnd')"
							onfocus="ConsoleTypingBegin(document); ConsoleForceOpenNewest(document); OnEvent(event, 'Console.HandleInputFocusBegin')"/>
				</div>
				<div id="input-info"><span id="input-count" data-rml="len(ConsoleModel.InputText)+'/120'"></span></div>
			</div>

			<!-- Log Panel -->
			<div class="log-panel" id="log-top">
				<div class="show-scrollbar wondow-content-full wondow-content-horizontal" id="log-content" onlistupdated="ConsoleLogUpdated(document, element)" onscroll="ConsoleChatScrolled(document, element)">
					<div id="log-lines">
						<div data-for="Line : ConsoleModel.ShowLogLines">
							<div class="chat_padding" data-class-alternate="IsOdd(Line)">
								<div id="text-line" data-rml="ToRMLText(ConsoleLogText(Line))" data-class-hidden="ConsoleLogDisplayType(Line) != 0"/>
								<div class="crazy_jim_panel" data-class-hidden="ConsoleLogDisplayType(Line) != 1">
									<div id="image" />
									<div id="text" data-rml="ToRMLText(ConsoleLogText(Line))" />
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Resize Handle -->
				<customhandle id="resize_bottom" class="resize_handle handle_bottom" size_target="#parent" edge_margin="0dp 0dp 0dp 0dp" onhandledrag="ConsoleResizeDrag(document)" onmouseup="ConsoleResizeEnd(document)"/>
			
		</div>
	</body>
</template>
