@spritesheet checkbox_sprites {
    src: interface/checkbox.rttex;
    resolution: 1x;
    checkbox_off_icon: 0px 0px 32px 32px;
    checkbox_on_icon: 32px 0px 32px 32px;
}

/* =======================================================================
   CLASSIC / PRE-DRAGGABLE GROWTOPIA CHAT LOOK

   Geometry is deliberately pinned from TOP + LEFT.  The Lua in Console.rml
   restores these values during resize so the handle can only keep the height.
   ======================================================================= */
.chat_region {
    position: absolute;
    left: 48dp;
    top: 0dp;
    right: auto;
    bottom: auto;
    z-index: 10;

    /* Slightly narrower than the previous build so the top-right list button
       stays clear, while the eye icon may still sit over the console. */
    width: 84.8vw;
    min-width: 84.8vw;
    max-width: 84.8vw;

    height: 145dp;
    min-height: 90dp;
    max-height: 470dp;

    padding: 0dp;
    margin: 0dp;
    box-sizing: border-box;
    overflow: visible;

    /* Put the actual classic cyan window behind EVERYTHING, including tabs. */
    decorator: tiled-box( window_border_sprite_tl, window_border_sprite_t, window_border_sprite_tr, window_border_sprite_cl, window_border_sprite_c, window_border_sprite_cr, window_border_sprite_bl, window_border_sprite_b, window_border_sprite_br );
    image-color: rgba(92, 187, 221, 218);
    background-color: transparent;
}

.hide #legacy_chat_window_fixed_2026,
.full-hide #legacy_chat_window_fixed_2026 {
    display: none;
}

/* =============================== TABS ================================== */
#filter {
    display: none;
    flex-direction: row;
    gap: 5dp;
    position: absolute;
    left: 10dp;
    top: 5dp;
    z-index: 60;
    height: 51dp;
    padding: 0dp;
}

/* Like the old client: tab strip appears when the console is opened tall. */
.chat_region.expanded #filter {
    display: flex;
}

#filter input[type="radio"] {
    display: none;
}

#filter label.filter_btn {
    opacity: 0.97;
    sound-on-click: true;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;

    height: 48dp;
    min-height: 48dp;
    min-width: 96dp;
    padding: 0dp 8dp 0dp 5dp;

    /* Old GT had a strong dark outer edge around every tab. */
    border-radius: 5dp;
    border: 2dp rgb(27, 43, 48);
}

#filter label.filter_btn:active {
    filter: brightness(0.90);
    transform: scale(0.98);
}

#filter input[type="radio"]:checked + label {
    opacity: 1.0;
    border: 2dp rgb(202, 244, 255);
    filter: brightness(1.06);
}

.filter_name {
    position: relative;
    top: 0dp;
    padding: 1dp 2dp 1dp 3dp;
    font-size: 0.80rem;
    font-weight: bold;
    color: rgb(245, 245, 235);
    font-effect: shadow(1dp 1dp #000);
}

/* Colors sampled by eye from the pre-new-UI reference. */
.filter_all_clr     { background-color: rgba(105, 181, 211, 244); }
.filter_world_clr   { background-color: rgba(201, 145, 38, 244); }
.filter_private_clr { background-color: rgba(65, 185, 188, 244); }
.filter_system_clr  { background-color: rgba(145, 148, 148, 244); }
.filter_custom_clr  { background-color: rgba(172, 105, 176, 244); }

.filter_all     { decorator: image(interface/large/gui_chat_all.rttex); }
.filter_world   { decorator: image(interface/large/gui_chat_world.rttex); }
.filter_private { decorator: image(interface/large/gui_chat_private.rttex); }
.filter_system  { decorator: image(interface/large/gui_chat_system.rttex); }
.filter_custom  { decorator: image(interface/large/gui_chat_custom.rttex); }

#filter .icon {
    width: 34dp;
    min-width: 34dp;
    height: 34dp;
    display: block;
}

/* Custom filter settings button. The RML already hides this unless CUSTOM
   is selected, matching the current GT behavior while keeping the classic row. */
.chat_settings {
    display: flex;
    align-items: center;
    justify-content: center;
    sound-on-click: true;
    width: 48dp;
    min-width: 48dp;
    height: 48dp;
    min-height: 48dp;
    padding: 0dp;
    opacity: 0.97;
    background-color: rgba(172, 105, 176, 244);
    border-radius: 5dp;
    border: 2dp rgb(27, 43, 48);
}

.chat_settings:active {
    filter: brightness(0.90);
    transform: scale(0.98);
}

#chat_image {
    width: 34dp;
    height: 34dp;
    decorator: image(interface/large/chat_settings.rttex);
}

/* =============================== LOG =================================== */
.log-panel {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 100%;
    height: 100%;
    box-sizing: border-box;

    /* Outer chat_region owns the frame/background, so this remains clear. */
    padding: 10dp 8dp 47dp 6dp;
    overflow: hidden;
}

.chat_region.expanded .log-panel {
    padding-top: 60dp;
}

#log-content {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;

    /* One classic cyan surface: the outer chat window owns the background. */
    background-color: transparent;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    font-size: 0.833rem;
    padding-left: 2dp;
}

#text-line {
    padding: 0dp 2dp 2dp 2dp;
    margin-top: 0dp;
}

.crazy_jim_panel {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    align-items: flex-start;
    width: 100%;
}

#image {
    min-width: 48dp;
    width: 48dp;
    height: 48dp;
    decorator: image(interface/tutorial/tut_npc.rttex);
}


/* ================= FORCE NEWEST CHAT MESSAGE TO BOTTOM ================= */
/* Keep the scrollable viewport conventional. Only the inner message stack
   reverses when Growtopia supplies ShowLogLines newest-first. */
#log-lines {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100%;
    box-sizing: border-box;
}

#log-lines.reverse-order {
    flex-direction: column-reverse;
}

/* ============================== INPUT ================================== */
.input-panel {
    position: absolute;
    left: 0dp;
    bottom: 0dp;
    top: auto;
    z-index: 30;

    width: 100%;
    height: 43dp;
    box-sizing: border-box;
    padding: 0dp 8dp 0dp 5dp;

    display: flex;
    flex-direction: row;

    decorator: tiled-box( window_border_sprite_tl, window_border_sprite_t, window_border_sprite_tr, window_border_sprite_cl, window_border_sprite_c, window_border_sprite_cr, window_border_sprite_bl, window_border_sprite_b, window_border_sprite_br );
    image-color: rgba(105, 190, 220, 215);
}

#input-content {
    width: 100%;
    padding: 0dp;
    display: flex;
    flex-direction: row;
    position: relative;
    background-color: rgba(35, 128, 162, 184);
    margin: 5dp 0dp 9dp 0dp;
}

#input-text {
    display: block;
    vertical-align: middle;
    border-radius: 6dp;
    font-weight: bold;
    line-height: 30dp;
    width: 100%;
    color: #fff;
    padding: 6dp 10dp 3dp 10dp;
    font-size: 0.85rem;
}

#input-info {
    display: block;
    vertical-align: middle;
    text-align: center;
    line-height: 38dp;
    color: #fff;
    font-weight: bold;
    background-color: rgba(132, 185, 205, 205);
    min-width: 76dp;
    height: 38dp;
    padding: 0dp;
    margin-top: 1dp;
    margin-bottom: 3dp;
    margin-right: 4dp;
    font-size: 0.833rem;
    border-radius: 6dp;
    top: 2dp;
    position: relative;
}

.message-hint-panel {
    width: 100%;
    padding: 0dp;
    display: block;
    position: absolute;
    top: auto;
    bottom: 12dp;
    left: 14dp;
    z-index: 40;
    font-size: 0.833rem;
    color: rgba(255,255,255,170);
    pointer-events: none;
}

/* ============================= PREVIEW ================================= */
.preview-panel {
    border-radius: 4pt;
    border: 2dp rgba(135, 184, 204, 104);
    width: 100%;
    padding: 0dp;
    display: flex;
    flex-direction: row;
    background-color: rgba(39,125,159,224);
    position: absolute;
    bottom: 45dp;
    left: 3dp;
    z-index: 45;
}

#preview-content { padding: 0dp; position: relative; }
#preview-text {
    display: block;
    vertical-align: middle;
    border-radius: 7dp;
    font-weight: bold;
    line-height: 30dp;
    width: 100%;
    color: #fff;
    font-size: 0.833rem;
    padding: 3dp;
}

/* ======================== OLD CENTER RESIZE SLIDER ===================== */
.resize_handle {
    width: 54dp;
    height: 29dp;
    padding: 0dp;
    decorator: image(interface/large/gui_chat_move_handle.rttex);
    image-color: rgba(255,255,255,255);
}

.handle_bottom {
    cursor: s-resize;
    position: absolute;
    left: 50%;
    margin-left: -27dp;
    bottom: -27dp;
    z-index: 70;
}

/* =========================== CUSTOM POPUP =============================== */
.popup {
    position: absolute;
    top: 58dp;
    left: 420dp;
    width: 280dp;
    background-color: rgba(60,137,166,220);
    border-radius: 4pt;
    border: 2dp rgb(136,184,203);
    padding: 0dp;
    z-index: 100;
    font-size: 0.833rem;
}

.checkbox-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    gap: 5dp;
    padding: 10dp;
}

.checkbox-group .label {
    padding-left: 0dp;
    vertical-align: middle;
    text-align: left;
}


/* Original Growtopia checkbox sprite implementation. Explicit class names are
   now present in Console.rml, so unchecked/checked icons render reliably. */
.checkbox-row {
    display: flex;
    align-items: center;
    gap: 8dp;
    sound-on-click: true;
}

.checkbox {
    display: inline-block;
    width: 22dp;
    min-width: 22dp;
    max-width: 22dp;
    height: 22dp;
    min-height: 22dp;
    max-height: 22dp;
    padding: 0dp;
    margin: 0dp;
    vertical-align: middle;
    decorator: image(checkbox_off_icon);
    sound-on-click: true;
}

.checkbox:checked {
    decorator: image(checkbox_on_icon);
}

.checkbox-group .label {
    padding-left: 0dp;
    vertical-align: middle;
    text-align: left;
}


/* ======================== CLEAN CLASSIC FINAL FIX ======================== */
/* Old-GT-like translucent cyan fill, inset under the original tiled border. */
#classic_chat_fill {
    position: absolute;
    left: 4dp;
    top: 4dp;
    right: 4dp;
    bottom: 4dp;
    z-index: 1;
    background-color: rgba(28, 151, 190, 136);
    pointer-events: none;
}

/* The entire visible chat uses the single fill above. */
.chat_padding,
.chat_padding.alternate {
    background-color: transparent;
}

.log-panel {
    z-index: 10;
}

/* Keep a little space above the first line even before resize/list callbacks. */
.log-panel {
    padding-top: 10dp;
}
.chat_region.expanded .log-panel {
    padding-top: 60dp;
}
#text-line {
    margin-top: 0dp;
}

/* V25: restored the compact v23 input row. The only visual change is a smaller
   0/120 pill so it fits cleanly inside the input strip without touching the
   separator or outer border. */
/* Keep the entire input strip safely INSIDE the outer GT frame.
   The 7dp inset is intentional: the separator, input background and
   0/120 box all stop before the tiled border instead of painting through it. */
.input-panel {
    position: absolute;
    left: 7dp;
    right: 7dp;
    bottom: 5dp;
    top: auto;
    width: auto;
    height: 39dp;
    padding: 0dp;
    decorator: none;
    background-color: transparent;
    border-top: 2dp rgb(136,184,203);
    overflow: hidden;
    z-index: 30;
}

/* Input text and counter are separate absolute boxes; they cannot overlap. */
#input-content {
    position: absolute;
    left: 4dp;
    right: 76dp;
    top: 4dp;
    bottom: 3dp;
    width: auto;
    height: auto;
    margin: 0dp;
    padding: 0dp;
    display: block;
    background-color: transparent;
    overflow: hidden;
}

#input-text {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 0dp;
    bottom: 0dp;
    width: 100%;
    height: 100%;
    box-sizing: border-box;

    /* 32dp content box: 26dp line + 3dp top + 3dp bottom.
       This keeps typed text exactly vertically centered. */
    line-height: 26dp;
    padding: 3dp 8dp 3dp 8dp;
}

#input-info {
    position: absolute;
    right: 4dp;
    top: 5dp;
    width: 66dp;
    min-width: 66dp;
    max-width: 66dp;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    box-sizing: border-box;
    padding: 0dp;
    margin: 0dp;
    display: block;
    background-color: rgba(135,184,204,185);
    border-radius: 6dp;
    overflow: hidden;
    z-index: 80;
}

#input-count {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 28dp;
    text-align: center;
    color: rgb(255,255,255);
    font-weight: bold;
    font-size: 0.833rem;
}

/* Empty-input hint uses the exact same vertical box/baseline as #input-text,
   so the placeholder and typed text never jump up/down when focus changes. */
.message-hint-panel {
    position: absolute;
    left: 19dp;      /* 7dp panel inset + 4dp content inset + 8dp text padding */
    right: 83dp;     /* leaves the counter column untouched */
    top: auto;
    bottom: 8dp;     /* 5dp panel bottom + 3dp input-content bottom */
    height: 32dp;
    padding: 0dp;
    margin: 0dp;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    line-height: 26dp;
    z-index: 40;
    pointer-events: none;
}

#message-hint-text {
    display: block;
    width: 100%;
    line-height: 26dp;
    padding: 0dp;
    margin: 0dp;
}

/* ======================= LIVE NEWEST-MESSAGE WATCHDOG =================== */
@keyframes chat-watchdog-a {
    from { opacity: 0.000; }
    to   { opacity: 0.001; }
}

@keyframes chat-watchdog-b {
    from { opacity: 0.001; }
    to   { opacity: 0.000; }
}

#chat-watchdog {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 1dp;
    height: 1dp;
    pointer-events: none;
    z-index: -10;
}

#chat-watchdog.watchdog-a {
    animation: 0.08s linear chat-watchdog-a;
}

#chat-watchdog.watchdog-b {
    animation: 0.08s linear chat-watchdog-b;
}


/* ====================== V28 INPUT + HANDLE FIX ==========================
   Keep all v27 behavior. Only correct the input baseline and restore the
   resize texture's native square aspect ratio. */

/* The real text field and empty hint now share this exact inner box. */
#input-content {
    top: 3dp;
    bottom: 4dp;
    overflow: hidden;
}

#input-text {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: -4dp;
    bottom: auto;
    width: 100%;
    height: 30dp;
    min-height: 30dp;
    max-height: 30dp;
    box-sizing: border-box;
    padding: 0dp 8dp 0dp 8dp;
    margin: 0dp;
    line-height: 30dp;
    vertical-align: middle;
}

/* This lives inside #input-content now, so it occupies the identical 30dp
   line box as typed text instead of using a separate screen-relative offset. */
#input-content .message-hint-panel {
    position: absolute;
    left: 8dp;
    right: 0dp;
    top: -4dp;
    bottom: auto;
    width: auto;
    height: 30dp;
    min-height: 30dp;
    max-height: 30dp;
    padding: 0dp;
    margin: 0dp;
    display: block;
    box-sizing: border-box;
    line-height: 30dp;
    z-index: 40;
    pointer-events: none;
}

/* data-class-hidden adds the hidden class. This selector is intentionally
   more specific than the block above so the placeholder really disappears
   as soon as InputText is non-empty. */
#input-content .message-hint-panel.hidden {
    display: none;
}

#input-content #message-hint-text {
    display: block;
    width: 100%;
    height: 30dp;
    padding: 0dp;
    margin: 0dp;
    line-height: 30dp;
    vertical-align: middle;
}

/* gui_chat_move_handle.rttex is natively 64x64. Keeping width == height
   prevents the old GT resize button from being squashed into a pill. */
.resize_handle {
    width: 56dp;
    min-width: 56dp;
    max-width: 56dp;
    height: 56dp;
    min-height: 56dp;
    max-height: 56dp;
    padding: 0dp;
    decorator: image(interface/large/gui_chat_move_handle.rttex);
    image-color: rgba(255,255,255,255);
}

.handle_bottom {
    left: 50%;
    margin-left: -28dp;
    bottom: -47dp;
}

/* ======================= V30 FINAL MICRO-TWEAKS ========================
   1) Leave a tiny clean gap between the newest chat line and the input
      separator.
   2) Match the compact old-GT resize handle reference (~40 x 24). */

/* The input separator sits ~44dp above the bottom. 50dp bottom padding
   leaves a small ~6dp visual breathing area above that line. */
.log-panel {
    padding-bottom: 50dp;
}

/* Old GT reference: compact horizontal '=' handle, approximately 40x24. */
.resize_handle {
    width: 40dp;
    min-width: 40dp;
    max-width: 40dp;
    height: 24dp;
    min-height: 24dp;
    max-height: 24dp;
    padding: 0dp;
    decorator: image(interface/large/gui_chat_move_handle.rttex);
    image-color: rgba(255,255,255,255);
}

.handle_bottom {
    left: 50%;
    margin-left: -20dp;
    bottom: -19dp;
}

/* ======================= V31 SLIGHTLY TALLER INPUT =====================
   Keep v30 behavior/spacing. Only give the input row a little more height
   so the text/hint and 0/120 pill breathe evenly inside the frame. */
.input-panel {
    height: 41dp;
}

#input-content {
    top: 3dp;
    bottom: 3dp;
}

#input-text {
    top: -3dp;
    height: 32dp;
    min-height: 32dp;
    max-height: 32dp;
    line-height: 32dp;
}

#input-content .message-hint-panel {
    top: -3dp;
    height: 32dp;
    min-height: 32dp;
    max-height: 32dp;
    line-height: 32dp;
}

#input-content #message-hint-text {
    height: 32dp;
    line-height: 32dp;
}

#input-info {
    top: 50%;
    margin-top: -14dp;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
}

#input-count {
    line-height: 28dp;
}

/* Keep roughly the same tiny gap above the separator after making the row taller. */
.log-panel {
    padding-bottom: 52dp;
}


/* ========================= V33 FINAL TWEAKS =============================
   Restore the original contraction limit, keep the larger expansion range,
   and center the compact 28dp counter vertically in the input strip. */


/* ================= OLD-GT INPUT VISIBILITY =============================
   Keep the input alive so GT can focus it from the keyboard, but don't draw
   the modern input strip until the player is actually typing.  Lua toggles
   .typing from the input's native focus/blur events. */
#input-panel {
    border-top-color: rgba(136,184,203,0);
}

#input-panel #input-content,
#input-panel #input-info {
    opacity: 0;
}

#input-panel.typing {
    border-top-color: rgb(136,184,203);
}

#input-panel.typing #input-content,
#input-panel.typing #input-info {
    opacity: 1;
}


/* ================== V35 TRUE OLD-GT COLLAPSING INPUT ===================
   When not typing, reserve ZERO chat layout space for the input strip.
   Keep a tiny transparent focus target alive because Growtopia focuses this
   element programmatically when chat is opened. Once focused, Lua adds
   .typing and the complete row is restored. */

/* No typing: collapse the entire visual row. */
#input-panel {
    height: 0dp;
    min-height: 0dp;
    max-height: 0dp;
    border-top-width: 0dp;
    border-top-color: rgba(136,184,203,0);
    overflow: visible;
    background-color: transparent;
    pointer-events: none;
}

/* Keep the input technically alive/focusable without occupying visible room. */
#input-panel #input-content {
    left: 4dp;
    right: 76dp;
    top: 0dp;
    bottom: auto;
    height: 1dp;
    min-height: 1dp;
    max-height: 1dp;
    opacity: 0;
    overflow: hidden;
}

#input-panel #input-text {
    top: 0dp;
    bottom: auto;
    height: 1dp;
    min-height: 1dp;
    max-height: 1dp;
    line-height: 1dp;
    padding-top: 0dp;
    padding-bottom: 0dp;
}

#input-panel #input-info,
#input-panel .message-hint-panel {
    opacity: 0;
}

/* Most importantly, don't leave the old 52dp blank reservation behind. */
.chat_region .log-panel {
    padding-bottom: 10dp;
}

/* Typing: restore the full old-GT input strip and its reserved log space. */
#input-panel.typing {
    height: 41dp;
    min-height: 41dp;
    max-height: 41dp;
    border-top-width: 2dp;
    border-top-color: rgb(136,184,203);
    overflow: hidden;
    pointer-events: auto;
}

#input-panel.typing #input-content {
    left: 4dp;
    right: 76dp;
    top: 3dp;
    bottom: 3dp;
    height: auto;
    min-height: 0dp;
    max-height: 64dp;
    opacity: 1;
}

#input-panel.typing #input-text {
    top: -3dp;
    bottom: auto;
    height: 32dp;
    min-height: 32dp;
    max-height: 32dp;
    line-height: 32dp;
    padding: 0dp 8dp 0dp 8dp;
}

#input-panel.typing #input-info,
#input-panel.typing .message-hint-panel {
    opacity: 1;
}

.chat_region.typing .log-panel {
    padding-bottom: 52dp;
}
